# API
PORT=3001
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data/sessions
FINAL_COLLAGE_TTL_MS=3600000

# PartyKit (local dev: run `pnpm --filter @photosocial/party dev`)
PARTYKIT_HOST=http://127.0.0.1:1999
PARTYKIT_BROADCAST_SECRET=dev-party-broadcast-secret

# Web (Vite)
# VITE_API_URL=https://your-api.example.com
# VITE_PARTYKIT_HOST=your-project.partykit.dev

# Optional: Supabase (opt-in cloud storage on export)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=PhotoSocial

# Optional: Mailpit for local email (default dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@photosocial.local
